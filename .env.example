# Copy this file to .env and fill in your own values.
# The app does not auto-load .env; on Node 20.6+ start it with:
#   node --env-file=.env server.js

# Public origin used inside payloads and Discord links. No trailing slash.
PUBLIC_BASE_URL=https://xss.example.com

# Dashboard login
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-to-a-long-password
SESSION_SECRET=change-this-to-a-long-random-string

# Optional Discord webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: directory for callbacks.jsonl (defaults to the app directory)
# DATA_DIR=/var/data

# Optional: free persistence with Upstash Redis (REST API)
# Create a free database at https://upstash.com/ and copy the REST URL/token.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# UPSTASH_REDIS_KEY=xsstrace:callbacks
